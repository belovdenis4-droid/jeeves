# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Workspace directory (default: ./workspace)
WORKSPACE_DIR=

# Heartbeat interval in minutes (default: 30)
HEARTBEAT_INTERVAL_MINUTES=

# Active hours for heartbeat (format: HH:MM, default: 08:00-23:00)
HEARTBEAT_ACTIVE_START=
HEARTBEAT_ACTIVE_END=

# Dead man's switch (optional): URL pinged on every heartbeat tick, 24/7.
# Create a check at https://healthchecks.io with period = your heartbeat
# interval and grace ~15 min, then paste its ping URL here. If the bot process
# or the whole server dies, pings stop and healthchecks.io alerts you
# (Telegram, email, etc.) — even when the host can't send anything itself.
HEALTHCHECK_PING_URL=

# Telegram chat ID to send heartbeat/cron messages to
TELEGRAM_CHAT_ID=

# OpenAI API key (optional — enables semantic memory search and voice transcription)
OPENAI_API_KEY=

# Log level (debug, info, warn, error — default: info)
LOG_LEVEL=info

# --- LLM provider (added) ---
# LLM_PROVIDER: bitrix | kimi | codex (codex = default OAuth via ChatGPT Plus/Pro)
LLM_PROVIDER=bitrix
# Bitrix GPT (OpenAI-compatible)
BITRIX_BASE_URL=https://vibecode.bitrix24.tech/v1
BITRIX_API_KEY=
BITRIX_MODEL=bitrix/bitrixgpt-5
# Kimi / Moonshot (switch: LLM_PROVIDER=kimi)
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-k2-0905-preview

# --- Pre-send moderation gate ---
# Checks every message against OpenAI safety categories BEFORE it reaches the
# LLM. Local RU/EN trigger-phrase filter is always active; when OPENAI_API_KEY
# is set, the official OpenAI Moderation API (omni-moderation-latest, free)
# is used as well. Flagged messages are NOT sent to the LLM — the user gets
# a warning with a rephrase suggestion; repeats are counted per chat.
# MODERATION_ENABLED: true | false (default: true)
MODERATION_ENABLED=true
